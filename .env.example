# Woodpecker CI server URL (required). Include the root path if the server
# runs under one (WOODPECKER_ROOT_PATH), e.g. https://example.com/ci
WOODPECKER_SERVER=https://ci.example.com

# Personal access token (required), from <server>/user/cli-and-api
WOODPECKER_TOKEN=your-token-here

# Log level, written to stderr (optional)
# RUST_LOG=woodpecker_ci_mcp=debug
